{
  "name": "SAR Solutions (voz mujer)",
  "description": "Igual que sar-solutions (azul marino + cian) pero con la voz femenina F2 locutora (ver voice.json).",
  "version": "1.0.0",
  "colors": {
    "primary": "#1E6BFF",
    "primaryLight": "#22D3EE",
    "textDark": "#071530",
    "textMedium": "#334155",
    "textLight": "#94A3B8",
    "bgLight": "#FFFFFF",
    "bgDark": "#071530",
    "bgOverlay": "rgba(7, 21, 48, 0.92)",
    "divider": "#1E3A6B",
    "shadow": "rgba(0, 0, 0, 0.35)",
    "warn": "#FF5A6E"
  },
  "fonts": {
    "primary": "\"Avenir Next\", Inter, system-ui, -apple-system, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, monospace"
  },
  "spacing": {
    "xs": 8,
    "sm": 16,
    "md": 24,
    "lg": 48,
    "xl": 80,
    "xxl": 120
